{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "universal-caldav-calendar",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "f502cef3511a46b2a90ba03fe657eb07"
    },
    {
      "binding": "CALENDAR_KV",
      "id": "c12c7d6bd0d649f3a6dcf35f81bbacf8"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://universal-caldav-calendar.liangke91.workers.dev",
    "DEFAULT_TIMEZONE": "Asia/Shanghai",
    "DEFAULT_REMINDER_MINUTES": "30",
    "ALLOWED_GITHUB_LOGINS": "liangke91-art"
  },
  "workers_dev": true,
  "preview_urls": false
}
